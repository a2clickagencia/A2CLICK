# Cabeçalhos do Cloudflare Pages (segurança e cache)
# Regra geral: valem para todas as páginas e arquivos.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action https://api.whatsapp.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
# HTML sem Cache-Control aqui: o padrão do Cloudflare Pages já é "public, max-age=0, must-revalidate".
# (Se o mesmo cabeçalho aparecesse aqui e numa regra abaixo, os valores seriam somados.)

# Sites de clientes do portfólio: têm scripts e fontes próprios, então ficam sem a CSP do site principal.
/portfolio/*
  ! Content-Security-Policy
  X-Robots-Tag: noindex

# JavaScript com hash no nome (muda a cada versão): pode ficar guardado por 1 ano.
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes: o nome do arquivo muda se a fonte mudar.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens: 30 dias, e o navegador confere em segundo plano depois disso.
/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# O service worker precisa ser conferido sempre.
/sw.js
  Cache-Control: no-cache

/site.webmanifest
  Cache-Control: public, max-age=86400
